{
  "phpVersion": "8.4",
  "plugins": ["./.wp-env/blocks-test-plugin"],
  "mappings": {
    "wp-content/plugins/blocks-test-plugin/vendor/kwio/gutenberg-blocks-framework": "."
  },
  "env": {
    "development": {
      "config": {
        "WP_POST_REVISIONS": 0,
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": false,
        "WP_DEBUG_LOG": "wp-content/plugins/const-defaults/debug.log",
        "WP_DEVELOPMENT_MODE": "all"
      }
    }
  }
}